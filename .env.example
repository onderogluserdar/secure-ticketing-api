# Copy to .env and fill in. .env is gitignored and no credential has a default,
# so nothing can silently inherit a shared password.

DB_NAME=ticketing
DB_USERNAME=ticketing
DB_PASSWORD=
DB_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/ticketing

# HS256 signing key, at least 32 bytes. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=

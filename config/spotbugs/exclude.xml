<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.1.0">

    <!--
        SPRING_ENDPOINT is informational: FindSecBugs reports every @RestController so a reviewer
        can find the attack surface. It is not a defect and would fire on every controller.
    -->
    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!--
        CSRF is deliberately disabled. Authentication is an explicit bearer token that a browser
        never attaches on its own, sessions are STATELESS and no cookie is ever issued, so there is
        no ambient credential for a cross-site request to abuse. See docs/security.md.
    -->
    <Match>
        <Class name="com.onderogluserdar.ticketing.security.SecurityConfig"/>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
    </Match>

    <!--
        HttpSecurity.build() declares `throws Exception`, so the bean method cannot narrow it.
    -->
    <Match>
        <Class name="com.onderogluserdar.ticketing.security.SecurityConfig"/>
        <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
    </Match>

    <!--
        User-Agent is spoofable, which is why it is only ever stored as audit metadata and never used
        to make a decision. Scoped to AuditService so the detector still applies everywhere else.
    -->
    <Match>
        <Class name="com.onderogluserdar.ticketing.audit.AuditService"/>
        <Bug pattern="SERVLET_HEADER_USER_AGENT"/>
    </Match>

    <!--
        Constructor-injected Spring singletons cannot be defensively copied, so EI_EXPOSE_REP2 has no
        available remedy here. Matched by field name rather than globally, so genuine cases such as a
        DTO storing a caller-supplied collection are still reported.
    -->
    <Match>
        <Field name="audit"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

</FindBugsFilter>
